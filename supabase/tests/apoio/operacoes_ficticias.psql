-- O gestor de frota ainda não tem Operações no seed; os testes do escopo por carteira dão a ele a
-- permissão só dentro da transação (a regra da função vale quando a permissão existir).
create function pg_temp.dar_operacoes_ao_gestor() returns void language sql as $$
  insert into config.permissao_do_perfil (perfil, modulo, acao, escopo)
  values ('gestor_de_frota', 'operacoes', 'ver', 'minha_carteira') on conflict do nothing;
$$;
