# Copie para .env.local e preencha com os valores do cofre. Nunca versione valores.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave mestra: só nos workers, nunca no navegador
SUPABASE_SERVICE_ROLE_KEY=
# Dados de exemplo (lib/exemplo/): só em desenvolvimento e testes, e vem pronto em .env.development.
# NUNCA defina EIXO_DADOS na Vercel nem em produção: sem ela, a fonte de exemplo se recusa a rodar.
# EIXO_DADOS=exemplo
# Ponte de consulta do Sankhya (workers/sankhya, só leitura): em .env.sankhya.local, fora do Git
SANKHYA_BASE_URL=
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=
SANKHYA_X_TOKEN=
SUPABASE_DB_PASSWORD=
